PORT=4000

# Rutas absolutas en el VPS
REPO_ROOT=/root/whatsapp-birthday-reminder
TEAMS_BASE_DIR=/root/whatsapp-teams
WWW_BASE_DIR=/var/www/apps
NGINX_INCLUDE_DIR=/etc/nginx/birthdays-teams.d
DOMAIN=tu-dominio.com

# 1 para loguear las acciones (pm2/build/nginx) sin ejecutarlas de verdad —
# útil para probar la lógica de slug/colisión/mutex sin tocar infraestructura real.
DRY_RUN=0
